   $(PLATFORM_SI_PACKAGE_DEC)
   $(PLATFORM_SAMPLE_PACKAGE_DEC)
   NovaLakeBoardPkg/BoardPkg.dec
   NovaLakeOpenBoardPkg/OpenBoardPkg.dec
   $(HP_SIO_PACKAGE_DEC)

[LibraryClasses]
   PeimEntryPoint
   PeiServicesLib
   DebugLib
   IoLib
   PcdLib
   HobLib
   PciExpressLib
   BaseMemoryLib
   OptionCardDetectLib

[Guids]

[Ppis]
