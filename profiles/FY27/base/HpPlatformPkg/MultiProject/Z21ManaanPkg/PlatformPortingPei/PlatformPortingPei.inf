[Defines]
   INF_VERSION                    = 0x00010005
   BASE_NAME                      = PlatformPortingPei
   FILE_GUID                      = 9D0AE5C4-7282-4996-9633-C4CE9D9ADBAC
   MODULE_TYPE                    = PEIM
   VERSION_STRING                 = 1.0
   ENTRY_POINT                    = PeiDriverEntry

[Sources]
   DriverEntry.c
   ./PlatformId/PlatformId.c

[Packages]
