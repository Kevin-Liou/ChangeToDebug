   gEfiHpPlatformPkgTokenSpaceGuid.gMediaReaderPresent|FALSE|BOOLEAN|0x10000001
   gEfiHpPlatformPkgTokenSpaceGuid.gWakeOnWWANSupport|FALSE|BOOLEAN|0x10000002
   gEfiHpPlatformPkgTokenSpaceGuid.gLidSwitchEventSupport|FALSE|BOOLEAN|0x10000003
   gEfiHpPlatformPkgTokenSpaceGuid.gScreenRotationEventSupport|FALSE|BOOLEAN|0x10000004
   gEfiHpPlatformPkgTokenSpaceGuid.gInteliFFSSupport|FALSE|BOOLEAN|0x10000005
   gEfiHpPlatformPkgTokenSpaceGuid.gESPAppSupport|TRUE|BOOLEAN|0x10000006
   gEfiHpPlatformPkgTokenSpaceGuid.gIsIntel|TRUE|BOOLEAN|0x10000009
   gEfiHpPlatformPkgTokenSpaceGuid.gEmbeddedControllerPresent|FALSE|BOOLEAN|0x1000000A

   # PCD for Memory Speed Throttle Down support.
   gEfiHpPlatformPkgTokenSpaceGuid.MemorySpeedThrottleDownSupport|FALSE|BOOLEAN|0x1000000B

   # PCD to determine if platform supports Mixed DIMM Alert.
   gEfiHpPlatformPkgTokenSpaceGuid.PcdMixedDimmAlertSupport|FALSE|BOOLEAN|0x1000000C

   ## PCD to define if platform supports Ambient light sensor feature.
   gEfiHpPlatformPkgTokenSpaceGuid.PcdAlsSupport|FALSE|BOOLEAN|0x1000000D


[PcdsDynamic, PcdsDynamicEx]
   #
   # Dynamic PCD for HP Platform
   #
   gEfiHpPlatformPkgTokenSpaceGuid.PcdPlatformBoardId|0|UINT32|0x30000000
   gEfiHpPlatformPkgTokenSpaceGuid.PcdIsConvertiblePlatform|FALSE|BOOLEAN|0x30000002
   gEfiHpPlatformPkgTokenSpaceGuid.PcdDGpuHwPresent|FALSE|BOOLEAN|0x30000003
   gEfiHpPlatformPkgTokenSpaceGuid.PcdTofHwPresent|FALSE|BOOLEAN|0x30000004
   gEfiHpPlatformPkgTokenSpaceGuid.PcdMeSku|0|UINT8|0x30000005
   gEfiHpPlatformPkgTokenSpaceGuid.PcdAudioSsid|0xFFFF|UINT16|0x30000006 # PCD for HDA controller and verb codec programming
   gEfiHpPlatformPkgTokenSpaceGuid.PcdIsMudWorkstationProductFamily|FALSE|BOOLEAN|0x30000007
   gEfiHpPlatformPkgTokenSpaceGuid.PcdColorAlsHwPresent|FALSE|BOOLEAN|0x30000008
   gEfiHpPlatformPkgTokenSpaceGuid.PcdAccelHwPresent|FALSE|BOOLEAN|0x3000000E
   gEfiHpPlatformPkgTokenSpaceGuid.PcdMemoryDownId|0x00000000|UINT32|0x30000009
   gEfiHpPlatformPkgTokenSpaceGuid.PcdPlatformIshEnable|0|UINT8|0x3000000A

   #
   # Dynamic PCD for HP PlatformID
   #
   # This PCD can only be used in HpPlatformPkg.
   # Do not use it out side of HpPlatformPkg.
   gEfiHpPlatformPkgTokenSpaceGuid.PcdHpPlatformID|0xFFFFFFFF|UINT32|0x3000000B

   # This PCD can only be used in HpPlatformPkg. 
   # Record the current Battery Wh usage.
   gEfiHpPlatformPkgTokenSpaceGuid.PcdHpBatteryWh|0xFFFF|UINT16|0x3000000C

[PcdsFixedAtBuild,PcdsPatchableInModule]

[PcdsFixedAtBuild, PcdsPatchableInModule, PcdsDynamic, PcdsDynamicEx]
   ## GPIO configuration for Serial Port A support detection.
   #  Structure: INTEL_GPIO_INFO { ExpanderNo, GpioNo, Active }
   #    - ExpanderNo: GPIO expander number (0 = not expander)
   #    - GpioNo: GPIO pad ID (GPIOV2_PAD_NONE or GPIOV2_PAD_INVALID = not supported)
   #    - Active: Active level (0 = low active, 1 = high active)
   gEfiHpPlatformPkgTokenSpaceGuid.PcdSerialPortAGpio|{0}|INTEL_GPIO_INFO|0x3000000D {
      <HeaderFiles>
         Library/HpGpioLib.h
         Nvl/Pch/GpioV2PinsNvlPchS.h
         Nvl/Pcd/GpioV2NvlPcdPins.h
      <Packages>
         HpFeature/HpFeatureMisc/PubIntPkg/HpFeatureMiscPubIntPkg.dec
         OneSiliconPkg/SiPkg.dec
   }

