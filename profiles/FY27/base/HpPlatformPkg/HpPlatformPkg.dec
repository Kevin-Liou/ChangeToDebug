[Defines]
   DEC_SPECIFICATION              = 0x0001001A
   PACKAGE_NAME                   = HpPlatformPkg
   PACKAGE_GUID                   = BFB93CF0-51D5-480d-995F-84F9A7A64DAF
   PACKAGE_VERSION                = 0.1

[Includes]
   Include
   Include/$(HP_PLATFORM_TYPE)/Setup

[LibraryClasses]

[Guids]
   gEfiHpPlatformPkgTokenSpaceGuid = { 0x147f9d49, 0xa8dc, 0x4089, { 0x99, 0x4b, 0x3e, 0xb9, 0x6d, 0xc2, 0xdb, 0x1c }}

   #Include\Guid\PlatformUndi.h
