[LibraryClasses]
   DebugLib
   BaseMemoryLib
   UefiDriverEntryPoint
   UefiBootServicesTableLib
   SmmServicesTableLib
   HpPlatformServicesLib
   PlatformBootOrderLib

[Depex]
