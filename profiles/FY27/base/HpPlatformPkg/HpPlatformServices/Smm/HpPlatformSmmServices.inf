[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = HpPlatformSmmServices
  FILE_GUID                      = DBEA47AE-E64B-4dd9-9586-151AEC8D5C18
  MODULE_TYPE                    = DXE_SMM_DRIVER
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x0001000A
